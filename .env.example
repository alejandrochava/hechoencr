# ---------------------------------------------------------------------
# Supabase — base de datos y autenticacion (Project Settings > API)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publica del sitio (metadatos y redireccion de OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Correo — aviso de los mensajes del formulario de contacto
#
# CONTACT_EMAIL nunca llega al navegador ni al repositorio: es solo del
# servidor. Usá un alias con "+" para no exponer la direccion real.
#
# En produccion: RESEND_API_KEY (API sobre HTTPS, funciona en serverless).
# En desarrollo: SMTP_HOST apunta a Mailpit y no sale nada a internet.
# ---------------------------------------------------------------------
CONTACT_EMAIL=tu-correo+hechoencr@gmail.com
RESEND_API_KEY=
MAIL_FROM=Hecho en CR <onboarding@resend.dev>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------
# Upstash Redis — contador compartido del limite de peticiones
#
# Sin esto el contador es por instancia: alcanza en local y en un servidor
# unico, pero en serverless cada instancia cuenta por su lado. Si falla,
# la aplicacion cae sola al contador local.
# ---------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
